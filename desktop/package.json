{
  "name": "sshthing-desktop",
  "version": "3.0.0-beta.2",
  "description": "SSHThing desktop — Electron + Go daemon",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dev": "pnpm run daemon:build && pnpm run build && electron .",
    "daemon:build": "cd .. && go build -ldflags=\"-X main.version=3.0.0-beta.2 -X github.com/Vansh-Raja/SSHThing/internal/cloud.DefaultBaseURL=https://testsshthing.vanshraja.me\" -o desktop/bin/sshthing-daemon ./cmd/sshthing-daemon && go build -ldflags=\"-X main.version=3.0.0-beta.2 -X github.com/Vansh-Raja/SSHThing/internal/app.defaultCloudBaseURL=https://testsshthing.vanshraja.me\" -o desktop/bin/sshthing ./cmd/sshthing && cd desktop && bash scripts/build-biometric.sh"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "clsx": "^2.1.0",
    "electron-window-state": "^5.0.3",
    "fuse.js": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "xterm": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
